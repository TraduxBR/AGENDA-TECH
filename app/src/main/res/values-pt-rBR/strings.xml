    <!-- Encrypted backup (.atbak) -->
    <string name="settings_backup">Backup criptografado</string>
    <string name="settings_backup_sub">Exporte ou restaure toda a agenda em um arquivo protegido por senha</string>
    <string name="backup_title">Backup criptografado</string>
    <string name="backup_intro_title">Uma cópia completa e criptografada</string>
    <string name="backup_intro_body">O arquivo contém tudo: calendários, eventos, recorrências, locais e lembretes. Ele é criptografado com sua senha (AES-256) — ninguém consegue abri-lo sem ela, nem mesmo nós. Guarde-o onde quiser: pendrive, computador ou nuvem.</string>
    <string name="backup_warn_title">A senha não pode ser recuperada</string>
    <string name="backup_warn_body">Em um backup exportado manualmente, a senha não é armazenada em nenhum lugar: se você esquecê-la, o arquivo ficará permanentemente ilegível. Guarde-a em um gerenciador de senhas. Os backups automáticos são uma exceção — para funcionar sem sua intervenção, eles precisam manter a senha neste celular, protegida pelo hardware seguro.</string>
    <string name="backup_export">Exportar backup</string>
    <string name="backup_export_sub">Criar um arquivo .atbak criptografado</string>
