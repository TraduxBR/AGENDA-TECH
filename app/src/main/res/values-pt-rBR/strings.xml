    <!-- About · Privacy -->
    <string name="about_privacy_title">Privacidade</string>
    <string name="about_privacy_card_title">100% privado — zero vigilância</string>
    <string name="about_privacy_body">O aplicativo não declara nenhuma permissão de Internet — tecnicamente, não consegue enviar nada para lugar algum. Sua agenda só sai deste celular se você mesmo a compartilhar ou exportar.</string>
    <string name="about_badge_no_network">Sem rede</string>
    <string name="about_badge_no_ads">Sem anúncios</string>
    <string name="about_badge_no_tracker">Sem rastreadores</string>
    <string name="about_badge_no_account">Sem conta</string>

    <!-- About · Features -->
    <string name="about_features_title">Recursos</string>
    <string name="about_feat_views_label">Visualizações de mês, semana, dia e agenda</string>
    <string name="about_feat_views_desc">Deslize entre os meses, exiba-os como pontos, títulos ou uma linha por dia, vá para hoje e use vários calendários.</string>
    <string name="about_feat_holidays_label">Feriados</string>
    <string name="about_feat_holidays_desc">Feriados de dez países, calculados no próprio celular: Áustria, Bélgica, França, Alemanha, Itália, Luxemburgo, Espanha, Suíça, Reino Unido e Estados Unidos.</string>
    <string name="about_feat_share_label">Compartilhamento e mapas</string>
    <string name="about_feat_share_desc">Compartilhe um evento como texto ou arquivo .ics e abra seu endereço no aplicativo de mapas. Você escolhe o aplicativo; o Agenda Tech não envia nada. Excluiu algo por engano? Use Desfazer para recuperar.</string>
    <string name="about_feat_recurrence_label">Eventos recorrentes</string>
    <string name="about_feat_recurrence_desc">De recorrências diárias a anuais, com intervalos personalizados e data de término — edite uma única ocorrência ou a série inteira.</string>
    <string name="about_feat_reminders_label">Lembretes</string>
    <string name="about_feat_reminders_desc">Alarmes exatos, horário personalizado e seu próprio toque. Os lembretes são reativados após a reinicialização.</string>
    <string name="about_feat_import_label">Importação / exportação</string>
    <string name="about_feat_import_desc">Copie os eventos que já estão neste celular (Google, Exchange etc.) ou troque arquivos .ics — tudo sem conexão com a Internet.</string>
    <string name="about_feat_widgets_label">Widgets da tela inicial</string>
    <string name="about_feat_widgets_desc">Próximos eventos e um ícone compacto de data.</string>
    <string name="about_feat_lock_label">Bloqueio por PIN / biometria</string>
    <string name="about_feat_lock_desc">Bloqueio opcional de todo o aplicativo, com proteção contra tentativas de adivinhação.</string>
    <string name="about_feat_encryption_label">Armazenamento criptografado</string>
    <string name="about_feat_encryption_desc">Todo o banco de dados é criptografado com AES-256; a chave nunca sai do hardware seguro do dispositivo.</string>
    <string name="about_feat_theme_label">Temas claro e escuro</string>
    <string name="about_feat_theme_desc">Segue o sistema ou permite escolher um tema fixo. Números das semanas, primeiro dia da semana e cor padrão.</string>
    <string name="about_feat_languages_label">Cinco idiomas</string>
    <string name="about_feat_languages_desc">Inglês, francês, alemão, italiano e espanhol — selecionáveis por aplicativo a partir do Android 13.</string>

    <!-- About · Security -->
    <string name="about_security_title">Segurança</string>
    <string name="about_security_card_title">Criptografado em repouso</string>
    <string name="about_security_body">O banco de dados (SQLCipher, AES-256) é criptografado com uma chave aleatória protegida pelo Android Keystore — respaldada por hardware e não exportável em dispositivos com elemento seguro. Sem seu celular, o arquivo é ilegível. Capturas de tela e a prévia na tela de recentes são bloqueadas por padrão, e os backups na nuvem são desativados para que sua agenda nunca seja copiada para fora do dispositivo.</string>

    <!-- About · Permissions -->
    <string name="about_permissions_title">Permissões e suas finalidades</string>
    <string name="about_perm_read_calendar">Somente leitura. Usada exclusivamente para copiar, quando você solicitar, os eventos já armazenados neste celular. Nunca grava dados nem os envia para lugar algum.</string>
    <string name="about_perm_notifications">Exibir seus lembretes.</string>
    <string name="about_perm_exact_alarm">Acionar um lembrete no minuto exato — um lembrete de calendário não serve para nada se chegar atrasado.</string>
    <string name="about_perm_boot">Reativar seus lembretes após uma reinicialização (os alarmes não sobrevivem à reinicialização).</string>
    <string name="about_perm_vibrate">Vibrar ao emitir um lembrete, se você ativar essa opção.</string>
    <string name="about_perm_no_internet_name">INTERNET — não solicitada</string>
    <string name="about_perm_no_internet">O aplicativo não tem nenhuma permissão de rede. Os links desta página são abertos no navegador, fora do aplicativo.</string>

